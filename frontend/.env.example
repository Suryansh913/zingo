# Copy to .env (local development) - Vite reads VITE_* variables at BUILD time.
# Local development (backend running with `python manage.py runserver`):
VITE_API_URL=http://localhost:8000

# PRODUCTION (set this in the Render static-site Environment tab, then "Clear build cache & deploy"):
#   VITE_API_URL=https://zingo-backend-o11v.onrender.com
# Rules: backend ORIGIN only. No trailing slash. No "/api" suffix. https:// in production.
