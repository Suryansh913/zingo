# ================= ZINGO backend environment (placeholders only - never commit real values) =================
DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=0                                   # 1 only on your own machine
DJANGO_ALLOWED_HOSTS=zingo-backend-o11v.onrender.com   # Render's own hostname is added automatically too
CORS_ALLOWED_ORIGINS=https://zingo-frontend.onrender.com   # frontend origin(s); no trailing slash; never '*'
CSRF_TRUSTED_ORIGINS=                            # only needed to log in to /admin from another origin
DATABASE_URL=postgres://user:password@host:5432/dbname      # empty = SQLite (wiped on every Render deploy)
RUN_MIGRATIONS=1                                 # start.sh applies pending (additive) migrations on boot
# ---- Media storage (videos + photos). Pick ONE. Cloudinary wins if both are set. ----
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME      # Cloudinary dashboard -> Settings -> API Keys ("API environment variable")
# CLOUDINARY_FOLDER=zingo                        # optional folder inside your Cloudinary media library
# CLOUDINARY_DELIVERY=upload                     # "authenticated" = signed URLs (only if your Cloudinary plan supports it)
# --- or S3-compatible instead of Cloudinary (AWS S3, Cloudflare R2, Backblaze B2...) ---
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=key-id
# AWS_SECRET_ACCESS_KEY=secret
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com   # empty for AWS S3
# AWS_S3_REGION_NAME=auto
# MEDIA_ROOT=/var/data/media                     # alternative: local path on a Render persistent disk (no Cloudinary/S3)
# ---- ZINGO Match / ZINGO Date (18+, live by default with self-declared ages) ----
MATCH_LAUNCH_STATE=self_declared                 # restricted = staff only | public = needs MATCH_REQUIRE_VERIFIED_AGE=1 + MATCH_MODERATION_CONFIRMED=1
DATE_LAUNCH_STATE=self_declared
# TURN relay for Match video calls (recommended): TURN_URLS=turn:host:3478  TURN_USERNAME=...  TURN_CREDENTIAL=...   (or TURN_SHARED_SECRET for coturn)
REDIS_URL=                                       # needed only when running more than one backend instance
MAX_VIDEO_MB=100

# ---- ZINGO Match ----
MATCH_REQUIRE_VERIFIED_AGE=0                # 1 = only users with age_verified=True (set by a real verification provider)
MATCH_MODERATION_CONFIRMED=0                # 1 = you attest that someone reviews reports promptly
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SHARED_SECRET=change-me                # coturn static-auth-secret => short-lived per-user credentials (preferred)
# TURN_USERNAME=  TURN_CREDENTIAL=          # alternative: static credentials
# Optional tuning: MATCH_QUEUE_TTL=60 MATCH_ACCEPT_SECONDS=20 MATCH_DISCONNECT_GRACE=30 MATCH_COOLDOWN_MINUTES=10 MATCH_MAX_SESSIONS_PER_HOUR=60 MATCH_AUTO_RESTRICT_REPORTS=3
# ---- Frontend (frontend/.env) ----
# VITE_API_URL=https://api.example.com
# ---- ZINGO Date (18+) ----
DATE_REQUIRE_VERIFIED_AGE=0                 # 1 = only users with age_verified=True (set by a real verification provider)
DATE_MODERATION_CONFIRMED=0                 # 1 = you attest that dating reports/photos are reviewed
# Optional tuning: DATE_MAX_LIKES_PER_DAY=100 DATE_AUTO_HOLD_REPORTS=3
